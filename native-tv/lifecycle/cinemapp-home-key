#!/bin/sh
# Cinema++: the remote's Home key (LG Input Hook, keybinds.json "773": exec).
# Opens Cinema++ on its Home screen; in the background so the hook, which runs
# inside LG's input process, never waits. luna-send stays silent and may not
# send when its stdin is at end of file, so stdin is a pipe held open.
# A native app already in front gets no launch parameters on a relaunch, so
# Cinema++ in front (on its settings, say) is closed and opened again on Home.
APP=com.tvweb.dashboard
(
  front=$( (sleep 2) | /usr/bin/luna-send -i -n 1 luna://com.webos.applicationManager/getForegroundAppInfo '{}' 2>/dev/null |
    sed -n 's/.*"appId"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
  if [ "$front" = "$APP" ]; then
    (sleep 3) | /usr/bin/luna-send -i -n 1 luna://com.webos.applicationManager/closeByAppId "{\"id\":\"$APP\"}" >/dev/null 2>&1
    usleep 300000 2>/dev/null || sleep 1
  fi
  (sleep 3) | /usr/bin/luna-send -i -n 1 luna://com.webos.applicationManager/launch \
    "{\"id\":\"$APP\",\"params\":{\"screen\":\"home\"}}" >/dev/null 2>&1
) </dev/null >/dev/null 2>&1 &
exit 0
